# ==============================================================================
# IVR ENERGY - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env.local for local development or set in Vercel / Railway
# ==============================================================================

# 1. Supabase / PostgreSQL Database Connection (Production)
# Direct connection string or transaction pooler from your Supabase Project Settings -> Database
DATABASE_URL="postgresql://postgres.[YOUR_PROJECT_REF]:[YOUR_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres"

# 2. Admin Authentication Secret (Required for secure JWT signing)
# Generate a random 64-character hex string using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_JWT_SECRET="ivr_sec_9f8a2b4c1d6e7f8a9b0c1d2e3f4a5b6c7d8e9f0a1b2c3d4e5f6a7b8c9d0e1f2"

# 3. Vercel Blob Storage Token (For cloud media uploads in Admin Panel)
# Retrieve from Vercel Dashboard -> Storage -> Blob -> Copy Token
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# 4. Real-time Lead Notification Webhooks (Optional)
# Supports Discord, Slack, Zapier, Make, n8n, or custom CRM webhooks
LEAD_NOTIFICATION_WEBHOOK="https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN"
# SLACK_WEBHOOK_URL="https://hooks.slack.com/services/T00/B00/XXXXXX"

# 5. Email Notifications via Resend API (Optional)
# Get from https://resend.com/api-keys
# RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxx"
# NOTIFICATION_EMAIL_TO="prakash@ivrenergy.com, sunil@ivrenergy.com"
